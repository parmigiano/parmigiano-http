# Database configurations
DB_HOST=host.docker.internal
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Email configurations
SMTP_EMAIL=
SMTP_ADDR=
SMTP_PORT=
SMTP_PASSWORD=
SMTP_DOMAIN=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# S3 configurations
S3_PATH_STYLE=
S3_VIRTUAL_HOSTED_STYLE=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_USE_SSL=true

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis configurations
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# libretranslate
LIBRETRANSLATE_URL=http://libretranslate:5000

# NSFW image moderation sidecar. Docker Compose: http://nsfw:8081
# Local without sidecar: leave empty (skipped only when GO_ENV=DEV)
NSFW_URL=http://nsfw:8081

# Profanity text moderation sidecar (BadWords). Docker Compose: http://profanity:8082
# Local without sidecar: leave empty (skipped only when GO_ENV=DEV)
PROFANITY_URL=http://profanity:8082

# Server configurations
I18N_LOCATE=./src/infra/locale

SUPER_SECRET_KEY=
IV=

SERVER_BASE_ADDR=http://localhost:8080/api

# DDoS configurations
POW_DDOS_DIFFICULTY=1
POW_DDOS_SECRET=85eda0ad95a8f5a7b489ad9f74f2d348

# LLMs AI URL PATH
OLLAMA_PHI_HOST=http://ollama_phi:11434
OLLAMA_PHI_MODEL=phi3

# System configurations
LOG_DIR=./logs

TYPE=DEV # PROD
