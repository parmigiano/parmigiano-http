{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "http://localhost:8081/api/v2",
      "description": "Local"
    },
    {
      "url": "https://parmigianochat.ru/api/v2",
      "description": "Production"
    }
  ],
  "info": {
    "title": "Parmigiano Auth API",
    "version": "2.0.0",
    "description": "Authentication service for Parmigiano Chat."
  },
  "paths": {
    "/auth/logout": {
      "post": {
        "summary": "Revoke the current bearer session",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Current session revoked; no response body"
          },
          "401": {
            "description": "Missing, invalid or expired bearer session"
          },
          "500": {
            "description": "Failed to revoke the session in Redis"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login with email, password, and a one-time login token from /auth/verify",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect login information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Login token is missing, expired or does not match the email, or the account has no password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/create": {
      "post": {
        "summary": "Create an account with a one-time registration token from /auth/verify",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or the email is already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Registration token is missing, expired or does not match the email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/confirm/email": {
      "post": {
        "summary": "Mail confirmation, sending the code to the mail",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthConfirmEmail"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The code has been sent by email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "summary": "Consume the email code and return the next step",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code accepted. Branch on next: registration, password, or authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthNextRegistration"
                    },
                    {
                      "$ref": "#/components/schemas/AuthNextPassword"
                    },
                    {
                      "$ref": "#/components/schemas/AuthNextAuthenticated"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error, or the code is invalid, expired, or already used",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/delete": {
      "delete": {
        "summary": "Delete user account",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User has been deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthLogin": {
        "type": "object",
        "required": [
          "email",
          "login_token"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 5,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "login_token": {
            "type": "string",
            "description": "One-time token from /auth/verify when next is password. Leave empty in Swagger to reuse the last verify response.",
            "example": ""
          }
        }
      },
      "AuthCreate": {
        "type": "object",
        "required": [
          "name",
          "username",
          "email",
          "registration_token"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "registration_token": {
            "type": "string",
            "description": "One-time token from /auth/verify when next is registration. Leave empty in Swagger to reuse the last verify response.",
            "example": ""
          }
        }
      },
      "AuthConfirmEmail": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "AuthVerify": {
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "integer",
            "example": 123456
          }
        }
      },
      "AuthNextRegistration": {
        "type": "object",
        "required": [
          "next",
          "registration_token",
          "expires_in"
        ],
        "properties": {
          "next": {
            "type": "string",
            "enum": [
              "registration"
            ]
          },
          "registration_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "example": 600
          }
        }
      },
      "AuthNextPassword": {
        "type": "object",
        "required": [
          "next",
          "login_token",
          "expires_in"
        ],
        "properties": {
          "next": {
            "type": "string",
            "enum": [
              "password"
            ]
          },
          "login_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "example": 600
          }
        }
      },
      "AuthNextAuthenticated": {
        "type": "object",
        "required": [
          "next",
          "session_id",
          "expires_in"
        ],
        "properties": {
          "next": {
            "type": "string",
            "enum": [
              "authenticated"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "example": 172800
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
