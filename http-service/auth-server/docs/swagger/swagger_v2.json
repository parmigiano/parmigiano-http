{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "http://localhost:8081/api/v2",
      "description": "Local"
    },
    {
      "url": "https://parmigianochat.ru/api/v2",
      "description": "Production"
    }
  ],
  "info": {
    "title": "Parmigiano Auth API",
    "version": "2.0.0",
    "description": "Authentication service for Parmigiano Chat."
  },
  "paths": {
    "/auth/logout": {
      "post": {
        "summary": "Revoke the current bearer session",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Current session revoked; no response body"
          },
          "401": {
            "description": "Missing, invalid or expired bearer session"
          },
          "500": {
            "description": "Failed to revoke the session in Redis"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login with an email confirmation token and account password when configured",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "202": {
            "description": "Password required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found - need register",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/create": {
      "post": {
        "summary": "Only account registration, the user is created after the email is verified",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/confirm/email": {
      "post": {
        "summary": "Mail confirmation, sending the code to the mail",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthConfirmEmail"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The code has been sent by email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "summary": "Verification code before send request",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sending a session ID if the user is logged in and does not have a cloud password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "202": {
            "description": "Email verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email code is missing, expired or already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/delete": {
      "delete": {
        "summary": "Delete user account",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "X-Debug",
            "in": "header",
            "description": "Enabled dev mode (example skip PoW security)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Response language from the server (in which language the client is)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User has been deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthLogin": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 5,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 16
          }
        }
      },
      "AuthCreate": {
        "type": "object",
        "required": [
          "name",
          "username",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "AuthConfirmEmail": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "AuthVerify": {
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "integer",
            "example": 123456
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
