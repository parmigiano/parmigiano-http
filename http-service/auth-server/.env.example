# Database configurations
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Pool per process. Keep DB_MAX_OPEN modest while Postgres max_connections is 100.
DB_MAX_OPEN=16
DB_MAX_IDLE=8
DB_MIN_IDLE=2
DB_ACQUIRE_TIMEOUT_MS=3000
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
DB_MAX_LIFETIME_SEC=1800
DB_MAX_IDLE_TIME_SEC=300

# Email configurations
SMTP_EMAIL=
SMTP_ADDR=
SMTP_PORT=
SMTP_PASSWORD=
SMTP_DOMAIN=

# S3 configurations (avatar cleanup on account delete)
S3_PATH_STYLE=
S3_VIRTUAL_HOSTED_STYLE=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_USE_SSL=true

# Redis configurations
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Profanity text moderation sidecar (BadWords). Docker Compose: http://profanity:9191
# Local without sidecar: leave empty (skipped only when TYPE=DEV)
PROFANITY_URL=http://profanity:9191

# Server configurations
I18N_LOCATE=./src/infra/locale

SUPER_SECRET_KEY=
IV=

# DDoS configurations
POW_DDOS_DIFFICULTY=1
POW_DDOS_SECRET=85eda0ad95a8f5a7b489ad9f74f2d348

SERVER_BASE_ADDR=http://localhost:8081/api

# System configurations
LOG_DIR=./logs

TYPE=DEV # PROD
