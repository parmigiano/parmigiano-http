#include "handlers.h"
#include "httpx.h"
#include "utilities.h"
#include "redis/redis.h"
#include "redis/redis_email_confirm.h"
#include "redis/redis_verifycode.h"
#include <assert.h>
#include <cjson/cJSON.h>
#include <pthread.h>

static httpx_server_t server;
httpx_server_t* http_server = &server;
static char* password_hash;
static int account_exists = 1;
static int password_enabled = 1;
static int created;
void logger_info(const char* fmt, ...) { (void)fmt; }
void logger_error(const char* fmt, ...) { (void)fmt; }
user_core_t* db_user_core_get_by_email(PGconn* conn, char* email)
{
    (void)conn;
    if (!account_exists) return NULL;
    user_core_t* user = calloc(1, sizeof(*user));
    user->user_uid = 1234567890;
    user->email = strdup(email);
    user->password = password_enabled ? strdup(password_hash) : NULL;
    return user;
}
db_result_t db_user_create(PGconn* conn, user_core_t* core, user_profile_t* profile,
                          user_profile_access_t* access, user_active_t* active)
{
    (void)conn; (void)profile; (void)access; (void)active;
    assert(core->email_confirm);
    created++;
    return DB_OK;
}
static cJSON* request(chttpx_handler_t handler, const char* body, int expected)
{
    chttpx_request_t* req = calloc(1, sizeof(*req));
    chttpx_response_t* res = calloc(1, sizeof(*res));
    auth_token_t ctx = {.lang = "en", .x_req_id = "test"};
    req->context = &ctx;
    req->body = (unsigned char*)body;
    req->body_size = req->content_length = strlen(body);
    strcpy(req->content_type, "application/json");
    handler(req, res);
    if (res->status != expected)
        fprintf(stderr, "expected %d got %d: %s\n", expected, res->status, res->body);
    assert(res->status == expected);
    cJSON* result = cJSON_Parse((const char*)res->body);
    assert(result);
    free((void*)res->body); free(res); free(req);
    return result;
}
static void login(const char* email, const char* password, const char* token, int expected)
{
    char body[1024];
    snprintf(body, sizeof(body), "{\"email\":\"%s\",\"password\":\"%s\",\"confirmation_token\":\"%s\"}", email, password, token);
    cJSON_Delete(request(auth_login_handler_v2, body, expected));
}
static char* verify(int expected)
{
    assert(redis_verifycode_create("owner@example.com", 123456) == 0);
    cJSON* res = request(auth_verify_handler_v2, "{\"email\":\"OWNER@example.com\",\"code\":123456}", expected);
    cJSON* item = cJSON_GetObjectItem(res, "confirmation_token");
    char* token = item ? strdup(item->valuestring) : NULL;
    cJSON_Delete(res);
    cJSON_Delete(request(auth_verify_handler_v2, "{\"email\":\"owner@example.com\",\"code\":123456}", 409));
    return token;
}
static const char* concurrent_token;
static void* consume(void* unused)
{
    (void)unused;
    return (void*)(intptr_t)redis_email_confirmation_consume("owner@example.com", concurrent_token);
}
int main(void)
{
    setenv("REDIS_HOST", "127.0.0.1", 1); setenv("REDIS_PORT", "6379", 1);
    setenv("SUPER_SECRET_KEY", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", 1);
    setenv("IV", "AAAAAAAAAAAAAAAAAAAAAA==", 1);
    assert(redis_conn());
    cHTTPX_i18n("/app/src/infra/locale");
    password_hash = hash_password("CorrectPass9!");
    assert(password_hash);
    assert(verify_password("CorrectPass9!", password_hash));
    assert(!verify_password("WrongPass99!", password_hash));
    assert(!verify_password(NULL, password_hash));
    assert(!verify_password("", password_hash));
    assert(!verify_password("CorrectPass9!", "malformed"));
    assert(!verify_password("CorrectPass9!", NULL));

    /* A legacy global confirmation must not authorize any client. */
    freeReplyObject(redis_command("SET email_confirmed:owner@example.com 1 EX 1800"));
    cJSON_Delete(request(auth_login_handler_v2, "{\"email\":\"owner@example.com\",\"password\":\"CorrectPass9!\"}", 400));
    char* token = verify(202);
    assert(token && strlen(token) == 64);
    login("owner@example.com", "WrongPass99!", token, 401);
    login("other@example.com", "CorrectPass9!", token, 403);
    login("owner@example.com", "CorrectPass9!", token, 200);
    login("owner@example.com", "CorrectPass9!", token, 403);
    free(token);

    password_enabled = 0;
    assert(verify(200) == NULL);
    cJSON_Delete(request(auth_login_handler_v2, "{\"email\":\"owner@example.com\"}", 400));

    account_exists = 0;
    cJSON_Delete(request(auth_create_handler_v2, "{\"email\":\"owner@example.com\",\"name\":\"Owner\",\"username\":\"owner\"}", 400));
    assert(created == 0);
    token = verify(202);
    char body[1024];
    snprintf(body, sizeof(body), "{\"email\":\"owner@example.com\",\"name\":\"Owner\",\"username\":\"owner\",\"confirmation_token\":\"%s\"}", token);
    cJSON_Delete(request(auth_create_handler_v2, body, 201));
    cJSON_Delete(request(auth_create_handler_v2, body, 403));
    assert(created == 1);
    free(token);

    assert(redis_verifycode_create("owner@example.com", 123456) == 0);
    assert(redis_verifycode_consume("owner@example.com", 999999) == 0);
    assert(redis_verifycode_consume("owner@example.com", 123456) == 1);
    assert(redis_verifycode_consume("owner@example.com", 123456) == -1);

    token = redis_email_confirmation_create("owner@example.com");
    freeReplyObject(redis_command("EXPIRE email_proof:%s 0", token));
    assert(!redis_email_confirmation_consume("owner@example.com", token));
    free(token);
    token = redis_email_confirmation_create("owner@example.com");
    concurrent_token = token;
    pthread_t threads[8];
    for (int i=0; i<8; i++) assert(!pthread_create(&threads[i], NULL, consume, NULL));
    int successes = 0;
    for (int i=0; i<8; i++) { void* result; pthread_join(threads[i], &result); successes += (intptr_t)result; }
    assert(successes == 1);
    free(token);
    /* Redis errors must fail closed. */
    freeReplyObject(redis_command("SET verifycode:broken wrong"));
    freeReplyObject(redis_command("DEL verifycode:broken"));
    freeReplyObject(redis_command("LPUSH verifycode:broken wrong"));
    assert(redis_verifycode_consume("broken", 123456) == -2);
    redis_disconnect(); free(password_hash);
    puts("PASS: password, login, registration, legacy flags, email binding, replay, expiry, concurrency, Redis errors");
}
